#!/bin/bash
# secret — keep secrets in the OS credential store (macOS Keychain, or Windows
# Credential Manager under Git Bash) and inject them into commands without the
# value ever being printed (so it never reaches the chat transcript).
#
#   secret add NAME [--clipboard | --stdin | --phone]
#                                             save/replace (default: hidden-input dialog;
#                                             --phone prints a one-time link for a phone)
#   secret wait NAME                          after --phone: block until saved/expired
#   secret run NAME[=ENV] [...] -- cmd args   run cmd with secrets as env vars, output redacted
#   secret list                               names only, never values
#   secret has NAME                           exit 0 if it exists
#   secret delete NAME                        delete from the credential store
#
# macOS:   login Keychain, service "claude-secret", account NAME.
# Windows: Credential Manager, generic credential "claude-secret:NAME" (via secret-win.ps1).
# A names-only index lives in ~/.config/claude-secret/names (no values).

# Tracing would print values on this script's own stderr, outside the redaction
# pipe. Refuse to run traced instead of silently turning it off.
if [[ $- == *x* || ":${SHELLOPTS:-}:" == *:xtrace:* ]]; then
  echo "secret: refusing to run under xtrace (bash -x) — it would print secret values" >&2
  exit 1
fi
unset BASH_XTRACEFD

set -o pipefail

KC_SERVICE="claude-secret"
INDEX_DIR="${HOME}/.config/claude-secret"
INDEX_FILE="${INDEX_DIR}/names"
PHONE_DIR="${INDEX_DIR}/phone"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BIN_DIR="$(dirname "$SELF")"

die() { echo "secret: $*" >&2; exit 1; }

usage() {
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

valid_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]]; }

# Env var names that would let a value reconfigure the shell, the loader, or
# the redactor itself (and so leak). Rejected as injection targets.
unsafe_env() {
  case "$1" in
    __SECRET_*|PERL*|PATH|IFS|BASH_ENV|ENV|SHELLOPTS|BASHOPTS|PS4|PROMPT_COMMAND|HOME|SHELL|\
    LD_*|DYLD_*|PYTHON*|NODE_OPTIONS|RUBYOPT|CLAUDE_SECRET_*) return 0 ;;
  esac
  return 1
}

# A value is acceptable only if it is one line of printable ASCII. Checked on
# the whole string in-shell: a line-based grep would let embedded newlines
# through (which could inject commands into `security -i`).
valid_value() {
  local LC_ALL=C
  [[ "$1" != *[![:print:]]* ]]
}

case "$(uname -s)" in
  Darwin)               OS=mac ;;
  MINGW*|MSYS*|CYGWIN*) OS=win ;;
  *)                    die "unsupported OS — needs macOS, or Windows with Git Bash" ;;
esac

if [ "$OS" = mac ]; then
  command -v security >/dev/null 2>&1 || die "macOS Keychain CLI ('security') not found"
  STORE="macOS Keychain"
else
  # Started directly (e.g. by the phone helper) PATH may lack Git Bash's tools.
  export PATH="/usr/bin:/mingw64/bin:$PATH"
  command -v powershell.exe >/dev/null 2>&1 || die "powershell.exe not found"
  WIN_PS="$(cygpath -w "$BIN_DIR/secret-win.ps1")"
  STORE="Windows Credential Manager"
fi

# Windows backend: every call goes through secret-win.ps1. Values travel only on
# stdin/stdout pipes, never in argv. MSYS_NO_PATHCONV stops Git Bash rewriting args.
winps() {
  MSYS_NO_PATHCONV=1 powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$WIN_PS" "$@"
}

index_add() {
  mkdir -p "$INDEX_DIR" && chmod 700 "$INDEX_DIR"
  touch "$INDEX_FILE"
  grep -qx "$1" "$INDEX_FILE" || echo "$1" >> "$INDEX_FILE"
}

index_rm() {
  [ -f "$INDEX_FILE" ] || return 0
  grep -vx "$1" "$INDEX_FILE" > "$INDEX_FILE.tmp"
  mv "$INDEX_FILE.tmp" "$INDEX_FILE"
}

kc_exists() {
  if [ "$OS" = win ]; then winps exists "$1" >/dev/null 2>&1; return; fi
  security find-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1
}

kc_read() {
  if [ "$OS" = win ]; then CLAUDE_SECRET_INTERNAL=1 winps read "$1" 2>/dev/null | tr -d '\r'; return; fi
  security find-generic-password -s "$KC_SERVICE" -a "$1" -w 2>/dev/null
}

kc_delete() {
  if [ "$OS" = win ]; then winps delete "$1" >/dev/null 2>&1; return; fi
  security delete-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1
}

# macOS writes through `security -i` on stdin, so the value never appears in any
# process's argv (visible to `ps`). printf is a shell builtin — no argv either.
kc_write() {
  if [ "$OS" = win ]; then printf '%s' "$2" | winps write "$1" >/dev/null 2>&1; return; fi
  local esc=${2//\\/\\\\}
  esc=${esc//\"/\\\"}
  printf 'add-generic-password -U -s %s -a %s -l "Claude secret: %s" -w "%s"\n' \
    "$KC_SERVICE" "$1" "$1" "$esc" | security -i >/dev/null 2>&1
}

clip_get()   { if [ "$OS" = win ]; then winps clip-get | tr -d '\r'; else pbpaste; fi; }
clip_clear() { if [ "$OS" = win ]; then winps clip-clear >/dev/null 2>&1; else pbcopy </dev/null; fi; }

prompt_dialog() {
  if [ "$OS" = win ]; then winps dialog "$1" 2>/dev/null | tr -d '\r'; return; fi
  osascript - "$1" 2>/dev/null <<'OSA'
on run argv
  set n to item 1 of argv
  set r to display dialog ("Paste the value for secret  " & n & return & return & "It is saved to your macOS Keychain and never shown to Claude.") default answer "" with hidden answer with title "Claude Code – save secret" buttons {"Cancel", "Save"} default button "Save" cancel button "Cancel" with icon caution
  return text returned of r
end run
OSA
}

cmd_add() {
  local name=$1 source=${2:-dialog} value
  [ -n "$name" ] || die "usage: secret add NAME [--clipboard | --stdin]"
  valid_name "$name" || die "invalid name '$name' (letters, digits, _; must not start with a digit)"

  case "$source" in
    --phone)     phone_start "$name"; return ;;
    dialog)      value=$(prompt_dialog "$name") || die "cancelled — nothing saved" ;;
    --clipboard) value=$(clip_get) ; clip_clear ;;   # clear clipboard after reading
    --stdin)     IFS= read -r value ; value=${value%$'\r'} ;;
    *)           die "unknown option '$source'" ;;
  esac

  [ -n "$value" ] || die "empty value — nothing saved"
  case "$value" in
    *$'\n'*|*$'\r'*) value=; die "value must be a single line — nothing saved" ;;
  esac
  # Keychain's -w prints non-ASCII values as hex, which would corrupt them on read.
  valid_value "$value" || { value=; die "value contains non-printable or non-ASCII characters — not supported"; }
  # Credential Manager blobs are capped at 2560 bytes (1280 UTF-16 chars).
  [ "$OS" = win ] && [ ${#value} -gt 1280 ] && die "value too long for Credential Manager (max 1280 chars)"
  [ ${#value} -gt 4000 ] && die "value too long (max 4000 chars)"

  local verb=Saved len=${#value} back
  kc_exists "$name" && verb=Updated
  kc_write "$name" "$value"
  # Read back and compare in memory: catches truncation or mangling by the store.
  back=$(kc_read "$name") || { value=; die "failed to write to $STORE"; }
  if [ "$back" != "$value" ]; then
    value= back=
    kc_delete "$name"
    die "stored value did not match what was entered — removed it, nothing saved"
  fi
  value= back=
  index_add "$name"
  echo "$verb secret '$name' ($len chars) in $STORE."
  [ "$len" -lt 8 ] && echo "secret: warning — values under 8 characters are weak and easy to spot in redacted output" >&2
  return 0
}

find_python() {
  local c
  for c in python3 python py; do
    # Skips the Windows Store "python" stub, which exits non-zero.
    command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys' >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

# Starts the one-time phone page (detached) and prints its link. The value is
# entered on the phone and handed to `secret add NAME --stdin`; it never passes
# through this shell, the chat, or any file.
phone_start() {
  local name=$1 i pid py
  if [ "$OS" = win ]; then
    command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (winget install Cloudflare.cloudflared)"
  else
    command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (brew install cloudflared)"
  fi
  py=$(find_python) || die "python 3 not found"
  mkdir -p "$PHONE_DIR" && chmod 700 "$INDEX_DIR" "$PHONE_DIR"

  # Only one live link per name: stop an older one (pid file holds the OS-native pid).
  # Verify the pid still belongs to our helper first: a stale file could name a reused pid.
  pid=$( { tr -d '\r' < "$PHONE_DIR/$name.pid"; } 2>/dev/null )
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    if [ "$OS" = win ]; then
      MSYS_NO_PATHCONV=1 tasklist /FI "PID eq $pid" /NH 2>/dev/null | grep -qi python \
        && MSYS_NO_PATHCONV=1 taskkill /PID "$pid" /T /F >/dev/null 2>&1
    else
      ps -p "$pid" -o command= 2>/dev/null | grep -q 'secret-phone\.py' && kill "$pid" 2>/dev/null
    fi
  fi
  : > "$PHONE_DIR/$name.url"
  printf 'starting\n' > "$PHONE_DIR/$name.status"

  # The helper re-invokes this script as `<bash> <this script> add NAME --stdin`.
  if [ "$OS" = win ]; then
    # Detach through Start-Process so it outlives this shell. PowerShell -File would
    # read a "-I" argument as a parameter name, so isolate Python via env instead.
    ( unset PYTHONPATH PYTHONHOME PYTHONSTARTUP
      export PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1
      winps spawn "$(cygpath -w "$(command -v "$py")")" "$(cygpath -w "$BIN_DIR/secret-phone.py")" \
        "$name" "$(cygpath -w "$PHONE_DIR")" "$(cygpath -w "$BASH")" "$(cygpath -w "$SELF")"
    ) || die "failed to start phone helper"
  else
    nohup "$py" -I "$BIN_DIR/secret-phone.py" "$name" "$PHONE_DIR" "$BASH" "$SELF" \
      >/dev/null 2>&1 </dev/null &
    disown
  fi

  for i in $(seq 1 60); do
    [ -s "$PHONE_DIR/$name.url" ] && break
    case "$(cat "$PHONE_DIR/$name.status" 2>/dev/null)" in failed*) break ;; esac
    sleep 1
  done
  if [ -s "$PHONE_DIR/$name.url" ]; then
    echo "One-time link for '$name' (single use, expires in 5 min):"
    cat "$PHONE_DIR/$name.url"
  else
    die "$(cat "$PHONE_DIR/$name.status" 2>/dev/null || echo 'phone link failed to start')"
  fi
}

cmd_wait() {
  local name=$1 st i
  valid_name "$name" || die "usage: secret wait NAME"
  for i in $(seq 1 340); do
    st=$(cat "$PHONE_DIR/$name.status" 2>/dev/null)
    case "$st" in
      saved*)            echo "${st#saved: }"; return 0 ;;
      expired*|failed*)  die "$st" ;;
    esac
    sleep 1
  done
  die "timed out waiting for '$name'"
}

cmd_run() {
  local specs=() s name env val redact=""
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do specs+=("$1"); shift; done
  [ "${1:-}" = "--" ] || die "usage: secret run NAME[=ENV_VAR] ... -- command [args]"
  shift
  [ $# -gt 0 ] || die "no command given after --"
  [ ${#specs[@]} -gt 0 ] || die "name at least one secret before --"

  for s in "${specs[@]}"; do
    name=${s%%=*}
    env=${s#*=}
    [ "$env" = "$s" ] && env=$name
    valid_name "$name" || die "invalid secret name '$name'"
    valid_name "$env"  || die "invalid env var name '$env'"
    unsafe_env "$env"  && die "refusing to inject into '$env' (it controls the shell, loader or redactor)"
    val=$(kc_read "$name") || die "secret '$name' not found — add it with: /secret $name"
    export "$env=$val"          # builtin: value never in argv
    redact="${redact:+$redact,}$env"
  done
  unset val

  # stdout+stderr are merged and every injected value is replaced with
  # [secret:ENV] before anything is printed — in these forms: raw, JSON-escaped,
  # URL-encoded, hex, and base64/base64url at all three byte alignments (which
  # also catches it inside e.g. base64("user:" + value) Basic-auth headers).
  "$@" 2>&1 | __SECRET_REDACT="$redact" perl -pe '
    BEGIN {
      $| = 1;
      my $b64 = eval { require MIME::Base64; 1 };
      my %seen;
      my $add = sub { my ($f, $k) = @_; push @r, [quotemeta($f), $k] if length $f && !$seen{$f}++ };
      for my $k (split /,/, $ENV{__SECRET_REDACT}) {
        my $v = $ENV{$k}; next unless defined $v && length $v;
        $add->($v, $k);
        (my $j = $v) =~ s/(["\\])/\\$1/g;            $add->($j, $k);
        (my $js = $j) =~ s{/}{\\/}g;                  $add->($js, $k);
        (my $u = $v) =~ s/([^A-Za-z0-9\-._~])/sprintf("%%%02X", ord $1)/ge;
        (my $ul = $u) =~ s/%([0-9A-F]{2})/"%" . lc $1/ge;
        $add->($u, $k); $add->($ul, $k);
        (my $up = $u) =~ s/%20/+/g;                    $add->($up, $k);
        $add->(unpack("H*", $v), $k); $add->(uc unpack("H*", $v), $k);
        next unless $b64;
        for my $off (0 .. 2) {
          my $e = MIME::Base64::encode_base64(("\0" x $off) . $v, "");
          $e =~ s/=+$//;
          $e = substr($e, 4) if $off;                  # first group mixes in prefix bytes
          my @forms = ($off == 0 ? ($e) : ());
          push @forms, substr($e, 0, length($e) - 3) if length($e) > 3;   # last group mixes in what follows
          for my $f (@forms) {
            next if length($f) < 8;
            $add->($f, $k);
            (my $url = $f) =~ tr{+/}{-_};              $add->($url, $k);
          }
        }
      }
      @r = sort { length($b->[0]) <=> length($a->[0]) } @r;
    }
    for my $p (@r) { s/$p->[0]/[secret:$p->[1]]/g }'
  return "${PIPESTATUS[0]}"
}

cmd_list() {
  local n found=0
  [ -f "$INDEX_FILE" ] || { echo "(no secrets saved yet)"; return 0; }
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if kc_exists "$n"; then echo "$n"; found=1; else index_rm "$n"; fi
  done < "$INDEX_FILE"
  [ $found -eq 1 ] || echo "(no secrets saved yet)"
}

cmd_has() {
  valid_name "${1:-}" || die "usage: secret has NAME"
  kc_exists "$1" && { echo "yes"; return 0; }
  echo "no"; return 1
}

cmd_rm() {
  valid_name "${1:-}" || die "usage: secret delete NAME"
  kc_exists "$1" || die "secret '$1' not found"
  kc_delete "$1" || die "delete failed"
  index_rm "$1"
  echo "Deleted secret '$1' from $STORE."
}

sub=${1:-help}
shift 2>/dev/null
case "$sub" in
  add)          cmd_add "$@" ;;
  run)          cmd_run "$@" ;;
  wait)         cmd_wait "$@" ;;
  list|ls)      cmd_list ;;
  has)          cmd_has "$@" ;;
  rm|delete)    cmd_rm "$@" ;;
  help|-h|--help) usage 0 ;;
  *)            echo "secret: unknown command '$sub'" >&2; usage 1 ;;
esac
