#!/bin/bash -p
# secret — keep secrets in the OS credential store (macOS Keychain, or Windows
# Credential Manager under Git Bash) and inject them into commands without the
# value ever being printed (so it never reaches the chat transcript).
#
#   secret add NAME [--clipboard | --stdin | --phone]
#                                             save/replace (default: hidden-input dialog;
#                                             --phone prints a one-time link for a phone)
#   secret wait NAME                          after --phone: block until saved/expired
#   secret run NAME[=ENV] [...] -- cmd args   run cmd with secrets as env vars, output redacted
#   secret push NAME TARGET [opts]            send to a cloud env: vercel|github|cloudflare|fly|supabase|render
#   secret pipe NAME [--line|--env-line] -- cmd args   feed the value to any command's stdin
#   secret config [mode confirm|auto|full]    who may use secrets: ask each time / when asked / on its own
#   secret log [N]                            audit trail of adds/runs/pushes (no values)
#   secret list                               names only, never values
#   secret has NAME                           exit 0 if it exists
#   secret delete NAME                        delete from the credential store
#
# macOS:   login Keychain, service "claude-secret", account NAME.
# Windows: Credential Manager, generic credential "claude-secret:NAME" (via secret-win.ps1).
# A names-only index lives in ~/.config/claude-secret/names (no values).
#
# `bash -p` above: ignore BASH_ENV/ENV and inherited SHELLOPTS, so a caller can't
# inject startup code or tracing into this script.

# Tracing would print values on this script's own stderr, outside the redaction
# pipe. Refuse to run traced instead of silently turning it off.
if [[ $- == *x* || ":${SHELLOPTS:-}:" == *:xtrace:* ]]; then
  echo "secret: refusing to run under xtrace (bash -x) — it would print secret values" >&2
  exit 1
fi
unset BASH_XTRACEFD
trap - DEBUG

set -o pipefail

KC_SERVICE="claude-secret"
MODE_KEY="__CLAUDE_SECRET_MODE"     # reserved entry in the credential store
INDEX_DIR="${HOME}/.config/claude-secret"
INDEX_FILE="${INDEX_DIR}/names"
PHONE_DIR="${INDEX_DIR}/phone"
AUDIT_FILE="$INDEX_DIR/audit.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BIN_DIR="$(dirname "$SELF")"

die() { echo "secret: $*" >&2; exit 1; }

usage() {
  sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'PUSH'

push targets — the destination must always be named explicitly:
  vercel      --project NAME_OR_ID [--env production|preview|development] [--branch B] [--cwd DIR] [--sensitive]
  github      --repo OWNER/REPO [--env ENVIRONMENT] | --org ORG       [--gh-app actions|dependabot|codespaces]
  cloudflare  --name WORKER [--env ENV] | --pages PROJECT [--env ENV]
  fly         --app APP [--stage]
  supabase    --project-ref REF [--token SAVED_NAME]   (CLI login, or Management API token)
  render      --service srv-... [--token SAVED_NAME]   (default token secret: RENDER_API_KEY)
  common      [--as REMOTE_NAME]                         (name on the platform; default = NAME)
The value always travels on stdin, never argv or disk. Platform-token env vars
(VERCEL_TOKEN, GH_TOKEN, CLOUDFLARE_API_TOKEN, FLY_API_TOKEN, ...) are ignored:
the CLI's own login is used.
PUSH
  exit "${1:-0}"
}

valid_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]]; }
# User-facing names: names starting with "__" are reserved for the tool itself.
user_name() { valid_name "$1" && [[ "$1" != __* ]]; }

# Env var names that would let a value reconfigure the shell, the loader, or
# the redactor itself (and so leak). Compared case-insensitively (Windows env
# names are case-insensitive).
unsafe_env() {
  local u; u=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  case "$u" in
    __*|PERL*|PATH|IFS|BASH_ENV|ENV|SHELLOPTS|BASHOPTS|PS4|PROMPT_COMMAND|HOME|SHELL|\
    LD_*|DYLD_*|PYTHON*|NODE_OPTIONS|RUBYOPT|CLAUDE_SECRET_*|SYSTEMROOT|COMSPEC|PATHEXT) return 0 ;;
  esac
  return 1
}

# A value is acceptable only if it is one line of printable ASCII. Checked on
# the whole string in-shell: a line-based grep would let embedded newlines
# through (which could inject commands into `security -i`).
valid_value() {
  local LC_ALL=C
  [[ "$1" != *[![:print:]]* ]]
}

# Printable, single-line, length-capped text for dialogs, notifications and the log.
clean() {
  local s; s=$(printf '%s' "$1" | LC_ALL=C tr -d '\000-\010\013-\037\177' | tr '\t\n' '  ')
  [ ${#s} -gt 200 ] && s="${s:0:197}..."
  printf '%s' "$s"
}

case "$(uname -s)" in
  Darwin)               OS=mac ;;
  MINGW*|MSYS*|CYGWIN*) OS=win ;;
  *)                    die "unsupported OS — needs macOS, or Windows with Git Bash" ;;
esac

# Security-relevant tools are called by absolute path, and system directories go
# first in PATH, so a fake `osascript`, `perl` or `security` earlier on the
# caller's PATH can't fake a dialog, disable redaction or read the store.
# Platform CLIs (vercel, gh, ...) still come from the caller's PATH; their
# resolved path is shown in every confirmation and log entry.
if [ "$OS" = mac ]; then
  export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
  SECURITY=/usr/bin/security OSASCRIPT=/usr/bin/osascript PERL=/usr/bin/perl CURL=/usr/bin/curl
  [ -x "$SECURITY" ] || die "macOS Keychain CLI ($SECURITY) not found"
  STORE="macOS Keychain"
else
  export PATH="/usr/bin:/mingw64/bin:$PATH"
  POWERSHELL="$(cygpath -u "${SYSTEMROOT:-C:\\Windows}")/System32/WindowsPowerShell/v1.0/powershell.exe"
  PERL=/usr/bin/perl CURL=/mingw64/bin/curl
  [ -x "$CURL" ] || CURL=/usr/bin/curl
  [ -x "$POWERSHELL" ] || die "Windows PowerShell not found at $POWERSHELL"
  WIN_PS="$(cygpath -w "$BIN_DIR/secret-win.ps1")"
  STORE="Windows Credential Manager"
fi
[ -x "$PERL" ] || die "perl not found at $PERL"

# Windows backend: every call goes through secret-win.ps1. Values travel only on
# stdin/stdout pipes, never in argv. MSYS_NO_PATHCONV stops Git Bash rewriting args.
winps() {
  MSYS_NO_PATHCONV=1 "$POWERSHELL" -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$WIN_PS" "$@"
}

index_add() {
  mkdir -p "$INDEX_DIR" && chmod 700 "$INDEX_DIR"
  touch "$INDEX_FILE"
  grep -qx "$1" "$INDEX_FILE" || echo "$1" >> "$INDEX_FILE"
}

index_rm() {
  [ -f "$INDEX_FILE" ] || return 0
  grep -vx "$1" "$INDEX_FILE" > "$INDEX_FILE.tmp"
  mv "$INDEX_FILE.tmp" "$INDEX_FILE"
}

kc_exists() {
  if [ "$OS" = win ]; then winps exists "$1" >/dev/null 2>&1; return; fi
  "$SECURITY" find-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1
}

kc_read() {
  if [ "$OS" = win ]; then CLAUDE_SECRET_INTERNAL=1 winps read "$1" 2>/dev/null | tr -d '\r'; return; fi
  "$SECURITY" find-generic-password -s "$KC_SERVICE" -a "$1" -w 2>/dev/null
}

kc_delete() {
  if [ "$OS" = win ]; then winps delete "$1" >/dev/null 2>&1; return; fi
  "$SECURITY" delete-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1
}

# macOS writes through `security -i` on stdin, so the value never appears in any
# process's argv (visible to `ps`). printf is a shell builtin — no argv either.
# `security -i` reads fixed-size lines; an over-long line could spill into a
# second command, so the whole line is length-checked before it is sent.
kc_write() {
  if [ "$OS" = win ]; then printf '%s' "$2" | winps write "$1" >/dev/null 2>&1; return; fi
  local esc=${2//\\/\\\\} line
  esc=${esc//\"/\\\"}
  line=$(printf 'add-generic-password -U -s %s -a %s -l "Claude secret: %s" -w "%s"' \
    "$KC_SERVICE" "$1" "$1" "$esc")
  if [ ${#line} -ge 3800 ]; then line= esc=; return 2; fi
  printf '%s\n' "$line" | "$SECURITY" -i >/dev/null 2>&1
  local rc=$?; line= esc=; return $rc
}

clip_get()   { if [ "$OS" = win ]; then winps clip-get | tr -d '\r'; else /usr/bin/pbpaste; fi; }
clip_clear() { if [ "$OS" = win ]; then winps clip-clear >/dev/null 2>&1; else /usr/bin/pbcopy </dev/null; fi; }

prompt_dialog() {
  if [ "$OS" = win ]; then winps dialog "$1" 2>/dev/null | tr -d '\r'; return; fi
  "$OSASCRIPT" - "$1" 2>/dev/null <<'OSA'
on run argv
  set n to item 1 of argv
  set r to display dialog ("Paste the value for secret  " & n & return & return & "It is saved to your macOS Keychain and never shown to Claude.") default answer "" with hidden answer with title "Claude Code – save secret" buttons {"Cancel", "Save"} default button "Save" cancel button "Cancel" with icon caution
  return text returned of r
end run
OSA
}

# ---------------------------------------------------------------------------
# Autonomy mode, notifications and audit log (names/targets only, never values).
# The mode lives in the credential store itself (not a plain file), so editing
# or deleting a config file can't loosen it.

get_mode() {
  local m; m=$(kc_read "$MODE_KEY")
  case "$m" in confirm|auto|full) echo "$m" ;; *) echo auto ;; esac
}

audit() {   # audit ACTION NAMES TARGET RESULT
  mkdir -p "$INDEX_DIR" && chmod 700 "$INDEX_DIR"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$(clean "$1")" "$(clean "$2")" "$(clean "$3")" "$(clean "$4")" >> "$AUDIT_FILE"
}

notify() {  # desktop notification; text holds names/targets only
  local msg; msg=$(clean "$1")
  if [ "$OS" = win ]; then winps notify "$msg" >/dev/null 2>&1 &
  else "$OSASCRIPT" - "$msg" >/dev/null 2>&1 <<'OSA'
on run argv
  display notification (item 1 of argv) with title "claude-secret"
end run
OSA
  fi
}

# Native Allow/Deny dialog on this computer; denies after 120 s with no answer.
ask_human() {
  local msg; msg=$(clean "$1")
  if [ "$OS" = win ]; then
    [ "$(winps confirm "$msg" 2>/dev/null | tr -d '\r')" = allow ]
  else
    [ "$("$OSASCRIPT" - "$msg" 2>/dev/null <<'OSA'
on run argv
  set r to display dialog (item 1 of argv) with title "claude-secret" buttons {"Deny", "Allow"} default button "Deny" cancel button "Deny" with icon caution giving up after 120
  if gave up of r then return "deny"
  if button returned of r is "Allow" then return "allow"
  return "deny"
end run
OSA
)" = allow ]
  fi
}

cmd_config() {
  local key=${1:-} val=${2:-} cur
  cur=$(get_mode)
  if [ -z "$key" ]; then
    echo "mode=$cur"
    echo "  confirm  every run/push/pipe needs Allow in a dialog on this computer"
    echo "  auto     Claude uses/pushes secrets when you ask in chat (default)"
    echo "  full     Claude may push on its own when a task needs it"
    return 0
  fi
  [ "$key" = mode ] || die "usage: secret config [mode confirm|auto|full]"
  case "$val" in confirm|auto|full) ;; *) die "mode must be confirm, auto or full" ;; esac
  # Loosening the mode needs a human: otherwise an agent could switch itself to full.
  if [ "$cur" = confirm ] && [ "$val" != confirm ]; then
    ask_human "Change claude-secret mode from 'confirm' to '$val'? Secrets will be used without asking you first." \
      || die "not changed — the mode change was denied or timed out"
  elif [ "$cur" = auto ] && [ "$val" = full ]; then
    ask_human "Allow Claude to push secrets on its own (mode 'full')? You will still get a notification for each push." \
      || die "not changed — the mode change was denied or timed out"
  fi
  kc_write "$MODE_KEY" "$val" && [ "$(kc_read "$MODE_KEY")" = "$val" ] || die "could not save the mode"
  audit "config" "-" "mode" "$cur->$val"
  echo "mode=$val"
}

cmd_log() {
  local n=${1:-20}
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: secret log [N]"
  [ -f "$AUDIT_FILE" ] || { echo "(no activity yet)"; return 0; }
  tail -n "$n" "$AUDIT_FILE" | LC_ALL=C tr -d '\000-\010\013-\037\177'
}

# In confirm mode every use of a secret needs a click on this computer.
gate() {    # gate ACTION NAMES DESCRIPTION
  if [ "$(get_mode)" = confirm ]; then
    ask_human "Allow Claude to $1 secret $2: $3 ?" \
      || { audit "$1" "$2" "$3" "denied"; die "denied — approve it in the dialog on this computer (mode is 'confirm')"; }
  fi
}

inform() {  # inform ACTION NAME DESCRIPTION RESULT
  audit "$1" "$2" "$3" "$4"
  if [ "$4" = ok ]; then
    notify "Sent secret $2 to $3"
    echo "secret: SENT '$2' -> $(clean "$3")" >&2
  else
    notify "FAILED to send secret $2 to $3"
  fi
}

argv_desc() {  # readable, sanitised description of a command line (no values in it)
  local a out=""
  for a in "$@"; do out="$out ${a}"; done
  clean "${out# }"
}

# ---------------------------------------------------------------------------

cmd_add() {
  local name=$1 source=${2:-dialog} value
  [ -n "$name" ] || die "usage: secret add NAME [--clipboard | --stdin | --phone]"
  user_name "$name" || die "invalid name '$name' (letters, digits, _; not starting with a digit or '__')"

  case "$source" in
    --phone)     phone_start "$name"; return ;;
    dialog)      value=$(prompt_dialog "$name") || die "cancelled — nothing saved" ;;
    --clipboard) value=$(clip_get) ; clip_clear ;;   # clear clipboard after reading
    --stdin)
      # Silently replacing a saved secret from stdin would let an agent swap in a
      # token it controls. Overwrites need a click — except from the phone page,
      # where the user typed the value themselves.
      if kc_exists "$name" && ! from_phone_helper; then
        ask_human "Replace the saved secret '$name' with a new value supplied by a program (stdin)?" \
          || die "not replaced — '$name' already exists; overwriting via --stdin needs your approval in the dialog"
      fi
      IFS= read -r value ; value=${value%$'\r'} ;;
    *)           die "unknown option '$source'" ;;
  esac

  [ -n "$value" ] || die "empty value — nothing saved"
  case "$value" in
    *$'\n'*|*$'\r'*) value=; die "value must be a single line — nothing saved" ;;
  esac
  # Keychain's -w prints non-ASCII values as hex, which would corrupt them on read.
  valid_value "$value" || { value=; die "value contains non-printable or non-ASCII characters — not supported"; }
  # Credential Manager blobs are capped at 2560 bytes (1280 UTF-16 chars).
  [ "$OS" = win ] && [ ${#value} -gt 1280 ] && die "value too long for Credential Manager (max 1280 chars)"
  [ ${#value} -gt 3000 ] && die "value too long (max 3000 chars)"

  local verb=Saved len=${#value} back
  kc_exists "$name" && verb=Updated
  kc_write "$name" "$value" || { value=; die "could not write to $STORE (value too long once escaped?)"; }
  # Read back and compare in memory: catches truncation or mangling by the store.
  back=$(kc_read "$name") || { value=; die "failed to write to $STORE"; }
  if [ "$back" != "$value" ]; then
    value= back=
    kc_delete "$name"
    die "stored value did not match what was entered — removed it, nothing saved"
  fi
  value= back=
  index_add "$name"
  audit "add" "$name" "${source#--}" "ok"
  echo "$verb secret '$name' ($len chars) in $STORE."
  [ "$len" -lt 8 ] && echo "secret: warning — values under 8 characters are weak and easy to spot in redacted output" >&2
  return 0
}

from_phone_helper() {
  # True only when our parent process is the phone page helper.
  [ "$OS" = mac ] || return 1
  /bin/ps -o command= -p "$PPID" 2>/dev/null | grep -q 'secret-phone\.py'
}

find_python() {
  local c
  for c in python3 python py; do
    # Skips the Windows Store "python" stub, which exits non-zero.
    command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys' >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

# Starts the one-time phone page (detached) and prints its link. The value is
# entered on the phone and handed to `secret add NAME --stdin`; it never passes
# through this shell, the chat, or any file.
phone_start() {
  local name=$1 i pid py
  if [ "$OS" = win ]; then
    command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (winget install Cloudflare.cloudflared)"
  else
    command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (brew install cloudflared)"
  fi
  py=$(find_python) || die "python 3 not found"
  mkdir -p "$PHONE_DIR" && chmod 700 "$INDEX_DIR" "$PHONE_DIR"

  # Only one live link per name: stop an older one (pid file holds the OS-native pid).
  # Verify the pid still belongs to our helper first: a stale file could name a reused pid.
  pid=$( { tr -d '\r' < "$PHONE_DIR/$name.pid"; } 2>/dev/null )
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    if [ "$OS" = win ]; then
      MSYS_NO_PATHCONV=1 tasklist /FI "PID eq $pid" /NH 2>/dev/null | grep -qi python \
        && MSYS_NO_PATHCONV=1 taskkill /PID "$pid" /T /F >/dev/null 2>&1
    else
      /bin/ps -p "$pid" -o command= 2>/dev/null | grep -q 'secret-phone\.py' && kill "$pid" 2>/dev/null
    fi
  fi
  : > "$PHONE_DIR/$name.url"
  printf 'starting\n' > "$PHONE_DIR/$name.status"
  audit "phone-link" "$name" "-" "started"

  # The helper re-invokes this script as `<bash> -p <this script> add NAME --stdin`.
  if [ "$OS" = win ]; then
    # Detach through Start-Process so it outlives this shell. PowerShell -File would
    # read a "-I" argument as a parameter name, so isolate Python via env instead.
    ( unset PYTHONPATH PYTHONHOME PYTHONSTARTUP
      export PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1
      winps spawn "$(cygpath -w "$(command -v "$py")")" "$(cygpath -w "$BIN_DIR/secret-phone.py")" \
        "$name" "$(cygpath -w "$PHONE_DIR")" "$(cygpath -w "$BASH")" "$(cygpath -w "$SELF")"
    ) || die "failed to start phone helper"
  else
    nohup "$py" -I "$BIN_DIR/secret-phone.py" "$name" "$PHONE_DIR" "$BASH" "$SELF" \
      >/dev/null 2>&1 </dev/null &
    disown
  fi

  for i in $(seq 1 60); do
    [ -s "$PHONE_DIR/$name.url" ] && break
    case "$(cat "$PHONE_DIR/$name.status" 2>/dev/null)" in failed*) break ;; esac
    sleep 1
  done
  if [ -s "$PHONE_DIR/$name.url" ]; then
    echo "One-time link for '$name' (single use, expires in 5 min):"
    cat "$PHONE_DIR/$name.url"
  else
    die "$(cat "$PHONE_DIR/$name.status" 2>/dev/null || echo 'phone link failed to start')"
  fi
}

cmd_wait() {
  local name=$1 st i
  user_name "$name" || die "usage: secret wait NAME"
  for i in $(seq 1 340); do
    st=$(cat "$PHONE_DIR/$name.status" 2>/dev/null)
    case "$st" in
      saved*)            echo "${st#saved: }"; return 0 ;;
      expired*|failed*)  die "$st" ;;
    esac
    sleep 1
  done
  die "timed out waiting for '$name'"
}

cmd_run() {
  local specs=() s name env val redact=""
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do specs+=("$1"); shift; done
  [ "${1:-}" = "--" ] || die "usage: secret run NAME[=ENV_VAR] ... -- command [args]"
  shift
  [ $# -gt 0 ] || die "no command given after --"
  [ ${#specs[@]} -gt 0 ] || die "name at least one secret before --"

  for s in "${specs[@]}"; do
    name=${s%%=*}; env=${s#*=}; [ "$env" = "$s" ] && env=$name
    user_name "$name" || die "invalid secret name '$name'"
    valid_name "$env" || die "invalid env var name '$env'"
    unsafe_env "$env" && die "refusing to inject into '$env' (it controls the shell, loader or redactor)"
  done

  local cmd0 desc
  cmd0=$(command -v -- "$1" 2>/dev/null || printf '%s' "$1")
  desc="run $(argv_desc "$@") (via $cmd0)"
  gate "use" "${specs[*]}" "$desc"

  for s in "${specs[@]}"; do
    name=${s%%=*}; env=${s#*=}; [ "$env" = "$s" ] && env=$name
    val=$(kc_read "$name") || die "secret '$name' not found — add it with: /secret $name"
    export "$env=$val"          # builtin: value never in argv
    redact="${redact:+$redact,}$env"
  done
  unset val

  audit "run" "${specs[*]}" "$desc" "started"
  "$@" 2>&1 | __SECRET_REDACT="$redact" "$PERL" -pe "$REDACT_PL"
  return "${PIPESTATUS[0]}"
}

# Redaction filter (perl -pe). Reads the comma-separated env var names in
# __SECRET_REDACT and replaces each value with [secret:LABEL] in these forms:
# raw; JSON-escaped (incl. \/ and \u00XX for & < > ', and JSON-in-JSON);
# URL-encoded (strict, encodeURIComponent-style, "/" kept, + for space; upper
# and lower hex); hex; base64/base64url at all three byte alignments (which
# also catches it inside base64("user:" + value) Basic auth, minus 1-2 edge chars).
REDACT_PL='
    BEGIN {
      $| = 1;
      my $b64 = eval { require MIME::Base64; 1 };
      my %seen;
      my $add = sub { my ($f, $k) = @_; push @r, [quotemeta($f), $k] if length $f && !$seen{$f}++ };
      my $pct = sub { my ($s, $keep) = @_; $s =~ s/([^A-Za-z0-9$keep])/sprintf("%%%02X", ord $1)/ge; $s };
      for my $var (split /,/, $ENV{__SECRET_REDACT}) {
        my $v = $ENV{$var}; next unless defined $v && length $v;
        my $k = $ENV{"__SECRET_LABEL_$var"} // $var;  # shown as [secret:LABEL]
        $add->($v, $k);
        (my $j = $v) =~ s/(["\\])/\\$1/g;
        (my $js = $j) =~ s{/}{\\/}g;
        (my $jj = $j) =~ s/(["\\])/\\$1/g;            # JSON inside JSON / curl config
        for my $x ($j, $js, $jj) {
          $add->($x, $k);
          (my $ul = $x) =~ s/([&<>\x27])/sprintf("\\u%04x", ord $1)/ge;  $add->($ul, $k);
          (my $uu = $x) =~ s/([&<>\x27])/sprintf("\\u%04X", ord $1)/ge;  $add->($uu, $k);
        }
        for my $keep (q{\-._~}, q{\-._~!*\x27()}, q{\-._~/}) {
          my $u = $pct->($v, $keep);
          (my $lo = $u) =~ s/%([0-9A-F]{2})/"%" . lc $1/ge;
          (my $sp = $u) =~ s/%20/+/g;
          $add->($_, $k) for ($u, $lo, $sp);
        }
        $add->(unpack("H*", $v), $k); $add->(uc unpack("H*", $v), $k);
        next unless $b64;
        for my $off (0 .. 2) {
          my $e = MIME::Base64::encode_base64(("\0" x $off) . $v, "");
          $e =~ s/=+$//;
          $e = substr($e, 4) if $off;                   # first group mixes in prefix bytes
          my @forms = ($off == 0 ? ($e) : ());
          push @forms, substr($e, 0, length($e) - 3) if length($e) > 3;   # last group mixes in what follows
          for my $f (@forms) {
            next if length($f) < 8;
            $add->($f, $k);
            (my $url = $f) =~ tr{+/}{-_};               $add->($url, $k);
          }
        }
      }
      @r = sort { length($b->[0]) <=> length($a->[0]) } @r;
    }
    for my $p (@r) { s/$p->[0]/[secret:$p->[1]]/g }'

# ---------------------------------------------------------------------------
# push / pipe: send a stored value into another tool's stdin. The value goes
# only through pipes (printf is a builtin) and all output is redacted.

curlq() { local s=${1//\\/\\\\}; printf '%s' "${s//\"/\\\"}"; }   # curl config / JSON string escape

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "$1 not found — $2"; }

# Env vars that would make a platform CLI act for a different account, team or
# project than the user's own login. Cleared for every push.
PLATFORM_ENV="VERCEL_TOKEN VERCEL_ORG_ID VERCEL_PROJECT_ID VERCEL_TEAM_ID GH_TOKEN GITHUB_TOKEN
GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_HOST GH_REPO GH_CONFIG_DIR CLOUDFLARE_API_TOKEN
CF_API_TOKEN CLOUDFLARE_API_KEY CLOUDFLARE_EMAIL CLOUDFLARE_ACCOUNT_ID CF_ACCOUNT_ID
WRANGLER_HOME FLY_API_TOKEN FLY_ACCESS_TOKEN FLY_APP SUPABASE_ACCESS_TOKEN SUPABASE_PROJECT_ID
RENDER_API_KEY HTTPS_PROXY HTTP_PROXY ALL_PROXY https_proxy http_proxy all_proxy CURL_HOME"

cmd_pipe() {
  local name="" fmt=raw as=""
  name=${1:-}; shift || true
  user_name "$name" || die "usage: secret pipe NAME [--line|--env-line] [--as KEY] -- command [args]"
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do
    case "$1" in
      --line) fmt=line ;; --env-line) fmt=env ;; --raw) fmt=raw ;;
      --as) as=${2:-}; shift ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "no command given after --"
  as=${as:-$name}; valid_name "$as" || die "invalid --as name"
  local cmd0 desc
  cmd0=$(command -v -- "$1" 2>/dev/null || printf '%s' "$1")
  desc="pipe into: $(argv_desc "$@") (via $cmd0)"
  gate "send" "$name" "$desc"
  local val; val=$(kc_read "$name") || die "secret '$name' not found — add it with: /secret $name"
  local rc
  case "$fmt" in
    raw)  printf '%s' "$val" ;;
    line) printf '%s\n' "$val" ;;
    env)  printf '%s=%s\n' "$as" "$val" ;;
  esac | { "$@"; } 2>&1 | __SECRET_REDACT=__SECRET_V0 __SECRET_V0="$val" __SECRET_LABEL___SECRET_V0="$name" "$PERL" -pe "$REDACT_PL"
  rc=${PIPESTATUS[1]}
  val=
  if [ "$rc" = 0 ]; then inform "pipe" "$name" "$desc" ok; else inform "pipe" "$name" "$desc" "exit $rc"; fi
  return "$rc"
}

opt_ok() {  # opt_ok VALUE KIND — option values end up in a platform CLI's argv or an API URL
  local v=$1
  [ -z "$v" ] && return 0
  [[ "$v" == *..* ]] && return 1
  case "$2" in
    repo)    [[ "$v" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] ;;
    branch)  [[ "$v" =~ ^[A-Za-z0-9_][A-Za-z0-9._/-]*$ ]] ;;
    service) [[ "$v" =~ ^srv-[a-z0-9]+$ ]] ;;
    ref)     [[ "$v" =~ ^[a-z0-9]{6,40}$ ]] ;;
    *)       [[ "$v" =~ ^[A-Za-z0-9_][A-Za-z0-9._:@-]*$ ]] ;;   # no leading "-": can't become a flag
  esac
}

cmd_push() {
  local name=${1:-} target=${2:-}
  user_name "$name" && [ -n "$target" ] || die "usage: secret push NAME vercel|github|cloudflare|fly|supabase|render [options]  (see: secret help)"
  shift 2
  local as="" env="" repo="" org="" app="" project="" cwd="" worker="" pages="" service="" ref="" token="" branch="" sensitive="" stage="" ghapp=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) as=${2:-}; shift ;;           --env) env=${2:-}; shift ;;
      --repo) repo=${2:-}; shift ;;       --org) org=${2:-}; shift ;;
      --app) app=${2:-}; shift ;;         --project) project=${2:-}; shift ;;
      --cwd) cwd=${2:-}; shift ;;         --name) worker=${2:-}; shift ;;
      --pages) pages=${2:-}; shift ;;     --service) service=${2:-}; shift ;;
      --project-ref) ref=${2:-}; shift ;; --token) token=${2:-}; shift ;;
      --branch) branch=${2:-}; shift ;;   --gh-app) ghapp=${2:-}; shift ;;
      --sensitive) sensitive=1 ;;         --stage) stage=1 ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  as=${as:-$name}
  valid_name "$as" || die "invalid --as name '$as'"
  local o
  for o in "$env" "$org" "$app" "$project" "$worker" "$pages" "$ghapp"; do
    opt_ok "$o" generic || die "option value '$o' is not allowed (letters, digits, . _ : @ - ; no leading '-')"
  done
  opt_ok "$repo" repo       || die "--repo must look like OWNER/REPO"
  opt_ok "$branch" branch   || die "--branch has unsupported characters"
  opt_ok "$service" service || die "--service must look like srv-xxxx"
  opt_ok "$ref" ref         || die "--project-ref must be the lowercase project ref"
  [ -z "$token" ] || user_name "$token" || die "--token takes a saved secret NAME"
  if [ -n "$cwd" ]; then
    [ -d "$cwd" ] || die "--cwd '$cwd' is not a directory"
    cwd=$(cd "$cwd" && pwd)
  fi

  local desc; local -a cmd; local feed=raw api="" bin=""
  case "$target" in
    vercel)
      need_cmd vercel "install: npm i -g vercel, then vercel login"; bin=$(command -v vercel)
      [ -n "$project" ] || die "vercel needs --project NAME_OR_ID (the destination must be explicit)"
      env=${env:-production}
      desc="vercel project $project ($env${branch:+, branch $branch}${cwd:+, cwd $cwd}) as $as"
      cmd=("$bin" env add "$as" "$env"); [ -n "$branch" ] && cmd+=("$branch")
      cmd+=(--force --yes --project "$project")
      [ -n "$cwd" ] && cmd+=(--cwd "$cwd"); [ -n "$sensitive" ] && cmd+=(--sensitive) ;;
    github|gh)
      need_cmd gh "install GitHub CLI, then gh auth login"; bin=$(command -v gh)
      [ -n "$repo$org" ] || die "github needs --repo OWNER/REPO or --org ORG (the destination must be explicit)"
      desc="github ${org:+org $org}${repo:+repo $repo}${env:+, environment $env}${ghapp:+, $ghapp} as $as"
      cmd=("$bin" secret set "$as"); [ -n "$repo" ] && cmd+=(--repo "$repo")
      [ -n "$org" ] && cmd+=(--org "$org"); [ -n "$env" ] && cmd+=(--env "$env")
      [ -n "$ghapp" ] && cmd+=(--app "$ghapp") ;;
    cloudflare|cf|wrangler)
      need_cmd wrangler "install it first: npm i -g wrangler, then wrangler login"; bin=$(command -v wrangler)
      if [ -n "$pages" ]; then
        desc="cloudflare pages project $pages${env:+ ($env)} as $as"
        cmd=("$bin" pages secret put "$as" --project-name "$pages"); [ -n "$env" ] && cmd+=(--env "$env")
      else
        [ -n "$worker" ] || die "cloudflare needs --name WORKER or --pages PROJECT (the destination must be explicit)"
        desc="cloudflare worker $worker${env:+ ($env)} as $as"
        cmd=("$bin" secret put "$as" --name "$worker"); [ -n "$env" ] && cmd+=(--env "$env")
      fi ;;
    fly|flyio)
      local f=flyctl; command -v flyctl >/dev/null 2>&1 || f=fly; need_cmd "$f" "install flyctl, then fly auth login"; bin=$(command -v "$f")
      [ -n "$app" ] || die "fly needs --app APP"
      desc="fly app $app as $as"; feed=env
      cmd=("$bin" secrets import -a "$app"); [ -n "$stage" ] && cmd+=(--stage) ;;
    supabase)
      [ -n "$ref" ] || die "supabase needs --project-ref REF"
      if [ -n "$token" ] || [ "$OS" = win ]; then
        api=supabase; token=${token:-SUPABASE_ACCESS_TOKEN}; bin="$CURL"
        desc="supabase project $ref as $as (Management API, token $token)"
      else
        need_cmd supabase "install the Supabase CLI, then supabase login"; bin=$(command -v supabase)
        feed=dotenv; desc="supabase project $ref as $as"
      fi ;;
    render)
      [ -n "$service" ] || die "render needs --service SERVICE_ID (srv-...)"
      api=render; token=${token:-RENDER_API_KEY}; bin="$CURL"
      desc="render service $service as $as (API, token $token)" ;;
    *) die "unknown target '$target' — use vercel, github, cloudflare, fly, supabase or render (or: secret pipe NAME -- any-command)" ;;
  esac
  [ -n "$api" ] && { [ -x "$CURL" ] || die "curl not found at $CURL"; }
  desc="$desc (via $bin)"

  gate "send" "$name" "$desc"
  local val tok="" rc resp code
  val=$(kc_read "$name") || die "secret '$name' not found — add it with: /secret $name"
  if [ -n "$api" ]; then
    tok=$(kc_read "$token") || { val=; die "API token secret '$token' not found — save it with: /secret $token"; }
  fi

  # Platform CLIs run without any token/account/proxy env overrides: they use the
  # user's own login, so a planted env var can't redirect the secret elsewhere.
  local -a clean_env=(env); for o in $PLATFORM_ENV; do clean_env+=(-u "$o"); done

  if [ -n "$api" ]; then
    # Header + body go to curl on stdin (-K -). The response body is printed only
    # on failure (a success body may echo the value back), and then redacted.
    local url method cfg
    if [ "$api" = render ]; then
      url="https://api.render.com/v1/services/$service/env-vars/$as"; method=PUT
      cfg='header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\nheader = "Accept: application/json"\ndata = "{\\"value\\":\\"%s\\"}"\n'
      resp=$(printf "$cfg" "$(curlq "$tok")" "$(curlq "$(curlq "$val")")" \
        | "${clean_env[@]}" "$CURL" -sS -X "$method" -K - -w '\n%{http_code}' "$url" 2>&1); rc=$?
    else
      url="https://api.supabase.com/v1/projects/$ref/secrets"; method=POST
      cfg='header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\ndata = "[{\\"name\\":\\"%s\\",\\"value\\":\\"%s\\"}]"\n'
      resp=$(printf "$cfg" "$(curlq "$tok")" "$as" "$(curlq "$(curlq "$val")")" \
        | "${clean_env[@]}" "$CURL" -sS -X "$method" -K - -w '\n%{http_code}' "$url" 2>&1); rc=$?
    fi
    code=${resp##*$'\n'}
    if [ "$rc" = 0 ] && [[ "$code" =~ ^2[0-9][0-9]$ ]]; then
      echo "HTTP $code — accepted"
    else
      [ "$rc" = 0 ] && rc=22
      printf '%s\n' "${resp%$'\n'*}" \
        | __SECRET_REDACT=__SECRET_V0,__SECRET_V1 __SECRET_V0="$val" __SECRET_V1="$tok" \
          __SECRET_LABEL___SECRET_V0="$name" __SECRET_LABEL___SECRET_V1="$token" "$PERL" -pe "$REDACT_PL"
      echo "HTTP ${code:-error}"
    fi
    resp=
  elif [ "$feed" = dotenv ]; then
    # Supabase CLI only reads a file: hand it an in-memory pipe (/dev/fd), never a file on disk.
    # dotenv: single quotes are literal (no $VAR expansion); fall back to escaped
    # double quotes only when the value itself contains a single quote.
    local line dq
    if [[ "$val" != *"'"* ]]; then line="$as='$val'"
    else dq=$(curlq "$val"); line="$as=\"${dq//\$/\\\$}\""; fi
    "${clean_env[@]}" "$bin" secrets set --project-ref "$ref" --env-file <(printf '%s\n' "$line") 2>&1 \
      | __SECRET_REDACT=__SECRET_V0 __SECRET_V0="$val" __SECRET_LABEL___SECRET_V0="$name" "$PERL" -pe "$REDACT_PL"
    rc=${PIPESTATUS[0]}
    line= dq=
  else
    if [ "$feed" = env ]; then printf '%s=%s\n' "$as" "$val"; else printf '%s' "$val"; fi \
      | "${clean_env[@]}" "${cmd[@]}" 2>&1 \
      | __SECRET_REDACT=__SECRET_V0 __SECRET_V0="$val" __SECRET_LABEL___SECRET_V0="$name" "$PERL" -pe "$REDACT_PL"
    rc=${PIPESTATUS[1]}
  fi
  val= tok=
  if [ "$rc" = 0 ]; then inform "push" "$name" "$desc" ok
  else inform "push" "$name" "$desc" "exit $rc"; die "push failed (exit $rc) — see the output above"; fi
}

cmd_list() {
  local n found=0
  [ -f "$INDEX_FILE" ] || { echo "(no secrets saved yet)"; return 0; }
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    user_name "$n" || continue
    if kc_exists "$n"; then echo "$n"; found=1; else index_rm "$n"; fi
  done < "$INDEX_FILE"
  [ $found -eq 1 ] || echo "(no secrets saved yet)"
}

cmd_has() {
  user_name "${1:-}" || die "usage: secret has NAME"
  kc_exists "$1" && { echo "yes"; return 0; }
  echo "no"; return 1
}

cmd_rm() {
  user_name "${1:-}" || die "usage: secret delete NAME"
  kc_exists "$1" || die "secret '$1' not found"
  kc_delete "$1" || die "delete failed"
  index_rm "$1"
  audit "delete" "$1" "-" "ok"
  echo "Deleted secret '$1' from $STORE."
}

sub=${1:-help}
shift 2>/dev/null
case "$sub" in
  add)          cmd_add "$@" ;;
  run)          cmd_run "$@" ;;
  push)         cmd_push "$@" ;;
  pipe)         cmd_pipe "$@" ;;
  config)       cmd_config "$@" ;;
  log)          cmd_log "$@" ;;
  wait)         cmd_wait "$@" ;;
  list|ls)      cmd_list ;;
  has)          cmd_has "$@" ;;
  rm|delete)    cmd_rm "$@" ;;
  help|-h|--help) usage 0 ;;
  *)            echo "secret: unknown command '$sub'" >&2; usage 1 ;;
esac
