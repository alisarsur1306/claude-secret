#!/bin/bash
# secret — keep secrets in the macOS Keychain and inject them into commands
# without the value ever being printed (so it never reaches the chat transcript).
#
#   secret add NAME [--clipboard | --stdin | --phone]
#                                             save/replace (default: hidden-input dialog;
#                                             --phone prints a one-time link for a phone)
#   secret wait NAME                          after --phone: block until saved/expired
#   secret run NAME[=ENV] [...] -- cmd args   run cmd with secrets as env vars, output redacted
#   secret list                               names only, never values
#   secret has NAME                           exit 0 if it exists
#   secret delete NAME                        delete from Keychain
#
# Values live in the login Keychain under service "claude-secret", account NAME.
# A names-only index lives in ~/.config/claude-secret/names (no values).

set -o pipefail

KC_SERVICE="claude-secret"
INDEX_DIR="${HOME}/.config/claude-secret"
INDEX_FILE="${INDEX_DIR}/names"
PHONE_DIR="${INDEX_DIR}/phone"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

die() { echo "secret: $*" >&2; exit 1; }

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

valid_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]{0,63}$ ]]; }

command -v security >/dev/null 2>&1 || die "macOS Keychain ('security') not found — this tool is macOS-only"

index_add() {
  mkdir -p "$INDEX_DIR" && chmod 700 "$INDEX_DIR"
  touch "$INDEX_FILE"
  grep -qx "$1" "$INDEX_FILE" || echo "$1" >> "$INDEX_FILE"
}

index_rm() {
  [ -f "$INDEX_FILE" ] || return 0
  grep -vx "$1" "$INDEX_FILE" > "$INDEX_FILE.tmp"
  mv "$INDEX_FILE.tmp" "$INDEX_FILE"
}

kc_exists() { security find-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1; }

kc_read() { security find-generic-password -s "$KC_SERVICE" -a "$1" -w 2>/dev/null; }

# Writes through `security -i` on stdin, so the value never appears in any
# process's argv (visible to `ps`). printf is a shell builtin — no argv either.
kc_write() {
  local esc=${2//\\/\\\\}
  esc=${esc//\"/\\\"}
  printf 'add-generic-password -U -s %s -a %s -l "Claude secret: %s" -w "%s"\n' \
    "$KC_SERVICE" "$1" "$1" "$esc" | security -i >/dev/null 2>&1
}

prompt_dialog() {
  osascript - "$1" 2>/dev/null <<'OSA'
on run argv
  set n to item 1 of argv
  set r to display dialog ("Paste the value for secret  " & n & return & return & "It is saved to your macOS Keychain and never shown to Claude.") default answer "" with hidden answer with title "Claude Code – save secret" buttons {"Cancel", "Save"} default button "Save" cancel button "Cancel" with icon caution
  return text returned of r
end run
OSA
}

cmd_add() {
  local name=$1 source=${2:-dialog} value
  [ -n "$name" ] || die "usage: secret add NAME [--clipboard | --stdin]"
  valid_name "$name" || die "invalid name '$name' (letters, digits, _; must not start with a digit)"

  case "$source" in
    --phone)     phone_start "$name"; return ;;
    dialog)      value=$(prompt_dialog "$name") || die "cancelled — nothing saved" ;;
    --clipboard) value=$(pbpaste) ; pbcopy </dev/null ;;   # clear clipboard after reading
    --stdin)     IFS= read -r value ;;
    *)           die "unknown option '$source'" ;;
  esac

  [ -n "$value" ] || die "empty value — nothing saved"
  # Keychain's -w prints non-ASCII values as hex, which would corrupt them on read.
  if printf '%s' "$value" | LC_ALL=C grep -q '[^[:print:]]'; then
    die "value contains non-printable or non-ASCII characters — not supported"
  fi

  local verb=Saved
  kc_exists "$name" && verb=Updated
  kc_write "$name" "$value"
  kc_exists "$name" || die "failed to write to Keychain"
  index_add "$name"
  echo "$verb secret '$name' (${#value} chars) in macOS Keychain."
}

# Starts the one-time phone page (detached) and prints its link. The value is
# entered on the phone and handed to `secret add NAME --stdin`; it never passes
# through this shell, the chat, or any file.
phone_start() {
  local name=$1 i pid
  command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (brew install cloudflared)"
  command -v python3 >/dev/null 2>&1 || die "python3 not found"
  mkdir -p "$PHONE_DIR" && chmod 700 "$INDEX_DIR" "$PHONE_DIR"

  # Only one live link per name: stop an older one.
  pid=$(cat "$PHONE_DIR/$name.pid" 2>/dev/null)
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  : > "$PHONE_DIR/$name.url"
  printf 'starting\n' > "$PHONE_DIR/$name.status"

  nohup python3 -I "$(dirname "$SELF")/secret-phone.py" "$name" "$SELF" "$PHONE_DIR" \
    >/dev/null 2>&1 </dev/null &
  disown

  for i in $(seq 1 60); do
    [ -s "$PHONE_DIR/$name.url" ] && break
    case "$(cat "$PHONE_DIR/$name.status" 2>/dev/null)" in failed*) break ;; esac
    sleep 1
  done
  if [ -s "$PHONE_DIR/$name.url" ]; then
    echo "One-time link for '$name' (single use, expires in 5 min):"
    cat "$PHONE_DIR/$name.url"
  else
    die "$(cat "$PHONE_DIR/$name.status" 2>/dev/null || echo 'phone link failed to start')"
  fi
}

cmd_wait() {
  local name=$1 st i
  valid_name "$name" || die "usage: secret wait NAME"
  for i in $(seq 1 340); do
    st=$(cat "$PHONE_DIR/$name.status" 2>/dev/null)
    case "$st" in
      saved*)            echo "${st#saved: }"; return 0 ;;
      expired*|failed*)  die "$st" ;;
    esac
    sleep 1
  done
  die "timed out waiting for '$name'"
}

cmd_run() {
  local specs=() s name env val redact=""
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do specs+=("$1"); shift; done
  [ "${1:-}" = "--" ] || die "usage: secret run NAME[=ENV_VAR] ... -- command [args]"
  shift
  [ $# -gt 0 ] || die "no command given after --"
  [ ${#specs[@]} -gt 0 ] || die "name at least one secret before --"

  for s in "${specs[@]}"; do
    name=${s%%=*}
    env=${s#*=}
    [ "$env" = "$s" ] && env=$name
    valid_name "$name" || die "invalid secret name '$name'"
    valid_name "$env"  || die "invalid env var name '$env'"
    val=$(kc_read "$name") || die "secret '$name' not found — add it with: /secret $name"
    export "$env=$val"          # builtin: value never in argv
    redact="${redact:+$redact,}$env"
  done
  unset val

  # stdout+stderr are merged and every injected value (and its base64 form) is
  # replaced with [secret:ENV] before anything is printed.
  "$@" 2>&1 | __SECRET_REDACT="$redact" perl -MMIME::Base64 -pe '
    BEGIN {
      $| = 1;
      for my $k (split /,/, $ENV{__SECRET_REDACT}) {
        my $v = $ENV{$k}; next unless defined $v && length $v;
        push @r, [quotemeta($v), $k];
        push @r, [quotemeta(encode_base64($v, "")), $k];
      }
      @r = sort { length($b->[0]) <=> length($a->[0]) } @r;
    }
    for my $p (@r) { s/$p->[0]/[secret:$p->[1]]/g }'
  return "${PIPESTATUS[0]}"
}

cmd_list() {
  local n found=0
  [ -f "$INDEX_FILE" ] || { echo "(no secrets saved yet)"; return 0; }
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    if kc_exists "$n"; then echo "$n"; found=1; else index_rm "$n"; fi
  done < "$INDEX_FILE"
  [ $found -eq 1 ] || echo "(no secrets saved yet)"
}

cmd_has() {
  valid_name "${1:-}" || die "usage: secret has NAME"
  kc_exists "$1" && { echo "yes"; return 0; }
  echo "no"; return 1
}

cmd_rm() {
  valid_name "${1:-}" || die "usage: secret rm NAME"
  kc_exists "$1" || die "secret '$1' not found"
  security delete-generic-password -s "$KC_SERVICE" -a "$1" >/dev/null 2>&1 || die "delete failed"
  index_rm "$1"
  echo "Deleted secret '$1' from macOS Keychain."
}

sub=${1:-help}
shift 2>/dev/null
case "$sub" in
  add)          cmd_add "$@" ;;
  run)          cmd_run "$@" ;;
  wait)         cmd_wait "$@" ;;
  list|ls)      cmd_list ;;
  has)          cmd_has "$@" ;;
  rm|delete)    cmd_rm "$@" ;;
  help|-h|--help) usage 0 ;;
  *)            echo "secret: unknown command '$sub'" >&2; usage 1 ;;
esac
